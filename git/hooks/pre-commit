#!/bin/sh

if command -v gitleaks >/dev/null 2>&1; then
    GITLEAKS=gitleaks
elif toolbox run true >/dev/null 2>&1; then
    GITLEAKS="toolbox run gitleaks"
else
    echo "gitleaks not found, aborting commit"
    exit 1
fi

reporoot=$(git rev-parse --show-toplevel)
tmpdir="/tmp/gitleaks-staged"
rm -rf "$tmpdir"
mkdir -p "$tmpdir"
trap 'rm -rf "$tmpdir"' EXIT

git diff --staged --name-only --diff-filter=d | while IFS= read -r file; do
    mkdir -p "$tmpdir/$(dirname "$file")"
    git show ":$file" > "$tmpdir/$file"
done

$GITLEAKS detect --no-git --redact -s "$tmpdir" -i "$reporoot"
